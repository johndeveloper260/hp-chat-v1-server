{
  "permissions": {
    "allow": [
      "Edit",
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(npm run dev)",
      "Bash(npm start)",
      "Bash(node --test)",
      "Bash(node --test:*)",
      "Bash(node --check:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Read(.env)",
      "Read(./.env)",
      "Read(.env.*)",
      "Bash(cat .env)",
      "Bash(cat ./.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.js) node --check \"$f\";; esac",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
